# 共享仓库使用明确清单，避免把本地记录、截图、凭据和安装备份提交出去。
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/src/
!/tests/
!/.AAAtoool/
/.AAAtoool/*
!/.AAAtoool/install.mjs
!/.AAAtoool/start-dsh.mjs
!/.AAAtoool/restart-dsh.mjs
!/.AAAtoool/shared-runtime.mjs
!/.AAAtoool/share-project.mjs
!/.AAAtoool/package.json
!/.AAAdooc/
/.AAAdooc/*
!/.AAAdooc/SHARING.md
!/.AAAdooc/COMPATIBILITY.md

node_modules/
.env
.env.*
*.log
*.tgz
*.db
*.sqlite*
*.pem
*.key
.DS_Store
